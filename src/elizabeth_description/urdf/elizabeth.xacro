<?xml version="1.0" ?>
<robot name="elizabeth" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="rws_ip" default="None"/>
  <xacro:arg name="rws_port" default="80"/>

  <xacro:include filename="$(find abb_irb4600_support)/urdf/irb4600_40_255.xacro"/>
  <xacro:include filename="$(find elizabeth_description)/urdf/toolchanger_adapter_plates_extruder_t25.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>
</robot>
