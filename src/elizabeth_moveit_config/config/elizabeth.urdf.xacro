<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="elizabeth">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import elizabeth urdf file -->
    <xacro:include filename="$(find elizabeth_descriptions)/urdf/elizabeth.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="elizabeth.ros2_control.xacro" />


    <xacro:elizabeth_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
